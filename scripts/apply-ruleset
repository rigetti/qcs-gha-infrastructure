#!/usr/bin/env bash
# Apply a shared ruleset JSON file to a repository. See --help.

set -euo pipefail

usage() {
    cat <<'USAGE'
Apply a ruleset JSON file to a repository, creating it or updating the existing
ruleset of the same name.

usage: apply-ruleset [-h|--help] OWNER/REPO [RULESET_JSON]

  OWNER/REPO      Repository to apply the ruleset to, e.g. rigetti/todo-curator.
  RULESET_JSON    Ruleset to apply. Defaults to rulesets/default-branch.json
                  next to this script.

environment:
  DRY_RUN=1         Print what would change and exit. For an existing ruleset,
                    this is a diff against what is live.
  REPLACE_CHECKS=1  Also overwrite the repository's required status checks with
                    the ones in the file. Off by default; see below.

examples:
  apply-ruleset rigetti/my-repo
  DRY_RUN=1 apply-ruleset rigetti/my-repo
  apply-ruleset rigetti/my-repo rulesets/other.json

notes:
  Rulesets are matched by name, not id: ids are per-repository, so a shared
  file cannot carry one. A repository whose ruleset has a different name gets a
  second ruleset rather than an updated one — rename it first.

  Required status checks are left alone when updating. Check names come from a
  repository's own job and workflow names, so a shared file has no business
  overwriting them; the rule in the file only seeds a repository that has no
  ruleset yet.

  Needs `gh` authenticated with admin rights on the repository, and `jq`.

  Org-level rulesets (orgs/ORG/rulesets) take the same JSON and cover many
  repositories at once, without drifting per repository. Prefer them where you
  have org-admin rights.
USAGE
}

for arg in "$@"; do
    case "${arg}" in
        -h|--help)
            usage
            exit 0
            ;;
    esac
done

repo="${1:-}"
file="${2:-$(dirname "$0")/../rulesets/default-branch.json}"

if [[ -z "${repo}" ]]; then
    usage >&2
    exit 2
fi

if [[ ! -f "${file}" ]]; then
    echo "No such ruleset file: ${file}" >&2
    exit 1
fi

name="$(jq -r .name "${file}")"
if [[ -z "${name}" || "${name}" == "null" ]]; then
    echo "Ruleset file has no name: ${file}" >&2
    exit 1
fi

existing="$(gh api "repos/${repo}/rulesets" --jq \
    ".[] | select(.name == \"${name}\") | .id" 2>/dev/null || true)"

payload="$(mktemp)"
trap 'rm -f "${payload}"' EXIT
cp "${file}" "${payload}"

if [[ -n "${existing}" && -z "${REPLACE_CHECKS:-}" ]]; then
    live_checks="$(gh api "repos/${repo}/rulesets/${existing}" --jq \
        '[.rules[] | select(.type == "required_status_checks")]')"

    if [[ "${live_checks}" != "[]" ]]; then
        echo "Keeping the required status checks already set on ${repo}:"
        jq -r '.[].parameters.required_status_checks[]?.context
               | "  " + .' <<<"${live_checks}"
        jq --argjson live "${live_checks}" \
            '.rules = ([.rules[] | select(.type != "required_status_checks")] + $live)' \
            "${file}" > "${payload}"
    fi
fi

if [[ -n "${DRY_RUN:-}" ]]; then
    if [[ -n "${existing}" ]]; then
        echo "Would update ruleset '${name}' (id ${existing}) on ${repo}:"
        diff <(gh api "repos/${repo}/rulesets/${existing}" \
                 | jq -S '{enforcement, conditions, rules}') \
             <(jq -S '{enforcement, conditions, rules}' "${payload}") \
            && echo "  (no change)"
    else
        echo "Would create ruleset '${name}' on ${repo} from ${file}"
        jq -S '{enforcement, conditions, rules}' "${payload}"
    fi
    exit 0
fi

if [[ -n "${existing}" ]]; then
    echo "Updating ruleset '${name}' (id ${existing}) on ${repo}"
    gh api --method PUT "repos/${repo}/rulesets/${existing}" --input "${payload}" --jq .name
else
    echo "Creating ruleset '${name}' on ${repo}"
    gh api --method POST "repos/${repo}/rulesets" --input "${payload}" --jq .name
fi
